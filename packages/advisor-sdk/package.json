{
  "name": "@databolsa/advisor-sdk",
  "version": "3.6.2",
  "license": "Apache-2.0",
  "type": "module",
  "description": "SDK TypeScript tipado para a API do DataBolsa Advisor (camada organizacional B2B), gerado a partir do contrato OpenAPI do Advisor.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "gen:schema": "openapi-typescript ../../api/openapi-advisor.yaml -o src/schema.ts",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && bun build src/index.ts --target browser --format esm --outfile dist/index.js && tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "openapi-typescript": "^7",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "Rodrigo Klosowski",
  "homepage": "https://github.com/databolsahq/databolsa/tree/main/packages/advisor-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/databolsahq/databolsa.git",
    "directory": "packages/advisor-sdk"
  },
  "bugs": {
    "url": "https://github.com/databolsahq/databolsa/issues"
  },
  "keywords": [
    "databolsa",
    "advisor",
    "sdk",
    "typescript",
    "wealth",
    "openapi"
  ]
}
