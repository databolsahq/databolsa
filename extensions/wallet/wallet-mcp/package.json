{
  "name": "@databolsa/wallet-mcp",
  "version": "3.12.0",
  "databolsa": {
    "group": "extensions",
    "kind": "client",
    "public": true,
    "layer": "extension",
    "extension": "databolsa.wallet",
    "component": "mcp"
  },
  "license": "Apache-2.0",
  "type": "module",
  "description": "Servidor MCP da Wallet do DataBolsa (carteiras por workspace) — tools geradas a partir do contrato OpenAPI da Wallet. Autentica com a chave de API da plataforma (db_live_...).",
  "bin": {
    "databolsa-wallet-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "start": "node dist/index.js",
    "stdio": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --target node --outfile dist/index.js && sed -i '1s|^#!.*|#!/usr/bin/env node|' dist/index.js && cp ../../../api/openapi-wallet.yaml dist/openapi.yaml",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "yaml": "^2.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "Rodrigo Klosowski",
  "homepage": "https://github.com/databolsahq/databolsa/tree/main/extensions/wallet/wallet-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/databolsahq/databolsa.git",
    "directory": "extensions/wallet/wallet-mcp"
  },
  "bugs": {
    "url": "https://github.com/databolsahq/databolsa/issues"
  },
  "keywords": [
    "databolsa",
    "wallet",
    "carteira",
    "mcp",
    "model-context-protocol"
  ]
}
