{
  "name": "@databolsa/credit-mcp",
  "version": "3.12.0",
  "databolsa": {
    "group": "extensions",
    "kind": "client",
    "public": true,
    "layer": "extension",
    "extension": "databolsa.credit",
    "component": "mcp"
  },
  "license": "Apache-2.0",
  "type": "module",
  "description": "Servidor MCP da mesa de crédito do DataBolsa (Credit Desk) — tools geradas a partir do contrato OpenAPI do Credit. Autentica com a chave pessoal (db_live_...).",
  "bin": {
    "databolsa-credit-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "start": "node dist/index.js",
    "stdio": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --target node --outfile dist/index.js && sed -i '1s|^#!.*|#!/usr/bin/env node|' dist/index.js && cp ../../../api/openapi-credit.yaml dist/openapi.yaml",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "yaml": "^2.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Rodrigo Klosowski",
  "homepage": "https://github.com/databolsahq/databolsa/tree/main/extensions/credit/credit-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/databolsahq/databolsa.git",
    "directory": "extensions/credit/credit-mcp"
  },
  "bugs": {
    "url": "https://github.com/databolsahq/databolsa/issues"
  },
  "keywords": [
    "databolsa",
    "credit",
    "credito-privado",
    "fidc",
    "mcp",
    "model-context-protocol"
  ]
}
